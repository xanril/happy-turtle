{
  "name": "happy-turtle",
  "private": true,
  "type": "module",
  "scripts": {
    "extract": "node scripts/extract.mjs",
    "extract:minor": "node scripts/extract.mjs --bump minor",
    "extract:major": "node scripts/extract.mjs --bump major",
    "build:styles": "node style-dictionary/config.mjs",
    "pack": "npm run build:styles && npm pack ./packages/angular-styles && dotnet pack ./packages/maui-styles/HappyTurtle.Styles.csproj --configuration Release --output ./packages/maui-styles/dist"
  },
  "devDependencies": {
    "@ama-styling/figma-extractor": "15.2.1",
    "@ama-styling/style-dictionary": "15.2.1",
    "style-dictionary": "5.6.1"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0"
  }
}
